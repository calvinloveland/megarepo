# Devcontainer caches
/.devcontainer/cache/

# npm logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

logs/

# hivemind-llm coordinator logs
/active/dev-tools/hivemind-llm/coordinator/logs/*.log

# k33p store (local CAS, not committed)
/.k33p/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Wizard Fight local data
/active/games/wizard_fight/data/*.db
/active/games/wizard_fight/frontend/node_modules/
/active/games/wizard_fight/frontend/dist/

# Coverage files
.coverage
coverage.xml
*.coverage
**/.coverage
**/coverage.xml

# Common Node / build / env ignores
node_modules/
**/node_modules/
dist/
build/
out/
.cache/

# Lockfiles (track at package level if desired)
# npm: package-lock.json
# yarn: yarn.lock
# pnpm: pnpm-lock.yaml

# Python virtualenvs
.venv/
venv/
.venv-copilot/

# Environment files
.env
.env.*
.npm_token.txt

# Pi runtime artifacts
.pi/hiring-runs/
**/.pi/hiring-runs/

# IDE/editor folders
.vscode/
.idea/
.codex

# OS files
.DS_Store

# Log files
*.log

# Playwright / browser binaries (workspace-local cache)
.playwright_browsers/

# Runtime state files
*.pid

# Nix build result symlinks
result

devserver.log
devserver.pid

# Generated frontend materials (synced from active/games/powder_play/materials)
/active/games/powder_play/frontend/public/materials/


# Wizard Fight dev artifacts
/active/games/wizard_fight/.wizard_fight_dev.pids
/active/games/wizard_fight/.wizard_fight_ollama.pid
/active/games/wizard_fight/ollama.log
site/
.docs-site/
/data/

# egg-info build artifacts
*.egg-info/

# vroomon local secrets (gitignored; never commit)
.secrets/
electron/.secrets/

# ── Secret material — never commit ──────────────────────────────
# Private keys and credentials of any kind. The pre-commit gitleaks hook
# scans tracked source for pasted secrets; these patterns cover whole files
# that should never enter history at all.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.secret
secrets.*

# age private identities (the public recipient lives in .k33p/age-recipient.txt)
.k33p/*identity*
.k33p/age-identity.txt

# Scratch/temp report files the gitleaks hook may write
.gitleaks-report.*
.k33p/.lift-tmp.*
