  "author": "Calvin Loveland <calvin@loveland.dev>",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calvinloveland/megarepo.git",
    "directory": "active/personal/calnix/pi-packages/pi-warden"
  },
  "homepage": "https://github.com/calvinloveland/megarepo/tree/main/active/personal/calnix/pi-packages/pi-warden#readme",
  "bugs": {
    "url": "https://github.com/calvinloveland/megarepo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
