#!/usr/bin/env bash
# Print a tiny newspaper of the latest headlines.
# Usage: print-newspaper [--stories N] [--wrap N] [--no-cut]
set -euo pipefail

PRINTER="/dev/usb/lp0"
if [ ! -c "$PRINTER" ]; then
    echo "Error: printer not found at $PRINTER" >&2
    exit 1
fi

sudo nix-shell -p python3 --run "python3 '$HOME/bin/print-newspaper.py' $(printf '%q ' "$@")"
