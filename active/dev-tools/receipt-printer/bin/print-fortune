#!/usr/bin/env bash
# Print random fortunes on the thermal printer, one slip per fortune.
# Usage: print-fortune [count] [--max-chars N]
set -euo pipefail

PRINTER="/dev/usb/lp0"
if [ ! -c "$PRINTER" ]; then
    echo "Error: printer not found at $PRINTER" >&2
    exit 1
fi

# fortune-mod for the classic `fortune -s` behaviour, python3 for formatting.
sudo nix-shell -p python3 fortune --run "python3 '$HOME/bin/print-fortune.py' $(printf '%q ' "$@")"
