#!/usr/bin/env bash
# Print the current weather on the thermal printer.
# Usage: print-weather ["City, ST"] [--no-forecast] [--wrap N]
set -euo pipefail

PRINTER="/dev/usb/lp0"
if [ ! -c "$PRINTER" ]; then
    echo "Error: printer not found at $PRINTER" >&2
    exit 1
fi

sudo nix-shell -p python3 --run "python3 '$HOME/bin/print-weather.py' $(printf '%q ' "$@")"
