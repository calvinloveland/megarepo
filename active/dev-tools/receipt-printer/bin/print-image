#!/usr/bin/env bash
# Print an image to the Epson TM-T88V thermal receipt printer.
# Usage: print-image <path> [width height] [threshold]
set -euo pipefail

PRINTER="/dev/usb/lp0"
if [ ! -c "$PRINTER" ]; then
    echo "Error: printer not found at $PRINTER" >&2
    exit 1
fi
if [ $# -lt 1 ]; then
    echo "Usage: print-image <path> [width height] [threshold]" >&2
    exit 1
fi

sudo nix-shell -p python3Packages.pillow \
    --run "python3 '$HOME/bin/print-image.py' $(printf '%q ' "$@")"
